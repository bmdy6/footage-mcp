  {
    "start": 113.6,
    "end": 116.4,
    "text": "哪怕算上预览局部返修再出最终版"
  },
  {
    "start": 116.4,
    "end": 120.2,
    "text": "累计开机半小时渲染成本也就一块钱左右"
